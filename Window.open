<!DOCTYPE html>
<html>
    <head>

    </head>
<body>
<button onclick="option();">Enter</button>
<input id = "N" type ="text"/>

<script>
  function option(){  
  let num = document.getElementById("N").value;
  if(num == 1 )
  {
    alert("blue");
    document.body.style.backgroundColor = "blue";

  }
  else 
  {alert("green")
    document.body.style.backgroundColor="green";
  }

  }
 </script>
    </body>
</html>
