function text()
{
if(document.getElementById("N").value == "Background")
{let val = prompt("What color?")
  document.body.style.backgroundColor = val ;  
}
if(document.getElementById("N").value == "font color")
{
let val = prompt("What color?")
document.getElementById("p").style.color = val ; 
}
if(document.getElementById("N").value == "new quote")
{
    let val = prompt("what do you want as quoute?")
document.getElementById("p").innerHTML= val ;   
}

